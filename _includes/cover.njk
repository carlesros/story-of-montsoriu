<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - Digital Book</title>
  <meta name="description" content="One homeless cat. One legendary castle. A shared destiny. Read the real-life adventures and story of Montsoriu.">

  <!-- Theme Initializer (Defaults to system preference, prevents FOUC) -->
  <script>
    (function() {
      try {
        var savedTheme = localStorage.getItem('montsoriu-theme');
        if (savedTheme === 'dark' || savedTheme === 'light') {
          document.documentElement.setAttribute('data-theme', savedTheme);
        } else {
          var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', systemDark ? 'dark' : 'light');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="apple-touch-icon" href="/images/favicon.png">

  <!-- Google Fonts Preconnect & Stylesheets -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Main Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="page-cover">
  <!-- Minimalist Overlay Header with Dark/Light Toggle -->
  <header class="site-header cover-header">
    <div class="header-inner">
      <a href="/" class="brand-link" aria-label="The Story of Montsoriu Home">
        <img src="/images/logo.png" alt="Montsoriu Logo" class="brand-logo" width="40" height="40">
        <div class="brand-text">
          <span class="brand-name">The Story of Montsoriu</span>
          <span class="brand-tagline">An Ongoing Digital Book</span>
        </div>
      </a>
      <div class="header-actions">
        <button type="button" class="theme-toggle-btn" id="theme-toggle" aria-label="Toggle dark and light theme" title="Toggle dark / light theme">
          <svg class="theme-icon sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="theme-icon moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main>
    <div class="book-experience-track" id="book-track">
      <div class="book-stage" id="book-stage">
        
        <!-- The Reading Page Directly Revealed Under the Cover Leaf -->
        <div class="book-page-canvas" id="prologue" aria-label="Prologue">
          <div class="book-page-inner">
            <!-- Pure Prologue Text (Direct on the page, no outer box, no extra titles) -->
            <div class="prose prologue-prose">
              {{ content | safe }}
            </div>

            <!-- Featured Chapter Callout -->
            <div class="chapter-cta-card">
              <div class="chapter-cta-content">
                <div class="badge-row" style="margin-bottom: 0.5rem;">
                  <span class="badge">Chapter 1</span>
                  <span class="badge badge-castle">Near Montsoriu Castle</span>
                </div>
                <h3>Chapter 1: Determined to Live</h3>
                <p>
                  Weak, hurt, and lost in the dense woods under the shadow of the fortress, a hungry kitten hears strange footsteps echoing through the trees...
                </p>
              </div>
              <div class="chapter-cta-footer">
                <span class="chapter-cta-meta">Published • 10 min read</span>
                <a href="/chapter-1-determined-to-live/" class="btn btn-primary btn-sm">
                  Start Chapter 1 →
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- 3D Turning Front Cover Leaf (Pinned to viewport during opening) -->
        <div class="book-cover-leaf" id="cover-leaf">
          <!-- Front Face of the Cover Leaf -->
          <div class="book-cover-face book-cover-front">
            <div class="hero-bg-container">
              <img src="/images/portada.jpg" 
                   alt="Cover photograph of Montsoriu the cat standing gracefully in a sunlit tree" 
                   class="hero-bg-img"
                   fetchpriority="high"
                   loading="eager"
                   sizes="100vw"
                   eleventy:widths="600,1000,1600,2200"
                   eleventy:formats="avif,webp,jpeg">
            </div>

            <!-- Content pinned to the front cover leaf -->
            <div class="cover-content-stack">
              <div class="cover-logo-wrap">
                <img src="/images/logo.png" 
                     alt="Montsoriu cat silhouette in front of the rising sun" 
                     class="cover-hero-logo" 
                     width="88" 
                     height="85">
              </div>

              <h1 class="cover-hero-title is-over-image">{{ title }}</h1>
              
              <p class="cover-hero-tagline is-over-image">One homeless cat. One legendary castle. A shared destiny.</p>
            </div>

            <!-- Dynamic shading overlay as leaf turns away from light -->
            <div class="book-leaf-shade-front" id="leaf-shade-front"></div>
          </div>

          <!-- Back Face of the Cover Leaf (Vintage Endpaper / Dark Parchment) -->
          <div class="book-cover-face book-cover-back" aria-hidden="true">
            <div class="back-endpaper-pattern"></div>
            <div class="back-bookplate">
              <img src="/images/logo.png" alt="" class="back-bookplate-logo" width="60" height="58">
              <span class="back-bookplate-title">The Story of Montsoriu</span>
              <span class="back-bookplate-subtitle">Digital Edition</span>
            </div>
          </div>
        </div>

        <!-- Call to Action Button: Pinned to stage, fades out smoothly on scroll -->
        <div class="cover-hero-action" id="cover-action">
          <a href="#prologue" class="btn btn-journey" id="btn-begin-voyage" aria-label="Begin her voyage">
            <svg class="journey-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
            <span>Begin her voyage</span>
            <svg class="journey-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
        </div>

        <!-- Left spine hinge line -->
        <div class="book-spine-hinge" aria-hidden="true"></div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-inner">
      <img src="/images/logo.png" alt="Montsoriu Logo" class="footer-logo" width="32" height="32">
      <p class="footer-text">
        <strong>The Story of Montsoriu</strong> — A digital book narrating the real-life adventures and journey of Montsoriu.
      </p>
      <p class="footer-castle-note">
        Named in honor of the historic Castle of Montsoriu (Castell de Montsoriu), Catalonia.
      </p>
      <p class="footer-copy">
        &copy; The Story of Montsoriu. All rights reserved.
      </p>
    </div>
  </footer>

  <!-- Scroll-Driven 3D Page Turn & Theme Script -->
  <script>
    (function() {
      // 1. Theme Toggle Logic
      var themeBtn = document.getElementById('theme-toggle');
      if (themeBtn) {
        themeBtn.addEventListener('click', function() {
          var currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
          var nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', nextTheme);
          try {
            localStorage.setItem('montsoriu-theme', nextTheme);
          } catch (e) {}
        });
      }

      // Listen for system theme changes if user hasn't explicitly set preference
      if (window.matchMedia) {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
          try {
            if (!localStorage.getItem('montsoriu-theme')) {
              document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
            }
          } catch (err) {}
        });
      }

      // 2. Scroll-Driven 3D Book Page Turn
      var track = document.getElementById('book-track');
      var leaf = document.getElementById('cover-leaf');
      var action = document.getElementById('cover-action');
      var shade = document.getElementById('leaf-shade-front');
      var btn = document.getElementById('btn-begin-voyage');

      if (!track || !leaf) return;

      var ticking = false;

      function updatePageTurn() {
        var rect = track.getBoundingClientRect();
        var trackHeight = track.offsetHeight;
        var windowHeight = window.innerHeight;
        var totalScrollable = trackHeight - windowHeight;

        if (totalScrollable <= 0) {
          ticking = false;
          return;
        }

        var scrolled = -rect.top;
        var rawProgress = scrolled / totalScrollable;
        var progress = Math.min(Math.max(rawProgress, 0), 1);

        // Turn angle from 0deg to -125deg (smooth 3D book cover open)
        var angle = progress * -125;
        leaf.style.transform = 'rotateY(' + angle + 'deg)';

        // Dynamic shading as the cover turns
        if (shade) {
          shade.style.opacity = Math.min(progress * 1.3, 0.75);
        }

        // Button smoothly fades out during initial scroll
        if (action) {
          var btnOpacity = Math.max(1 - progress * 4.5, 0);
          action.style.opacity = btnOpacity;
          action.style.pointerEvents = btnOpacity < 0.05 ? 'none' : 'auto';
          action.style.transform = 'translate(-50%, ' + (progress * 24) + 'px)';
        }

        // Theme toggle button fades in as the cover opens and reveals the prologue
        if (themeBtn) {
          var toggleOpacity = Math.min(Math.max((progress - 0.05) * 3.5, 0), 1);
          themeBtn.style.opacity = toggleOpacity;
          themeBtn.style.pointerEvents = toggleOpacity > 0.3 ? 'auto' : 'none';
          themeBtn.style.transform = 'scale(' + (0.85 + toggleOpacity * 0.15) + ')';
        }

        var header = document.querySelector('.cover-header');
        if (header) {
          if (progress > 0.05) {
            header.classList.add('is-scrolled');
          } else {
            header.classList.remove('is-scrolled');
          }
        }

        // When cover is mostly open, disable pointer events on the leaf
        if (progress >= 0.85) {
          leaf.style.pointerEvents = 'none';
        } else {
          leaf.style.pointerEvents = 'auto';
        }

        ticking = false;
      }

      function onScroll() {
        if (!ticking) {
          requestAnimationFrame(updatePageTurn);
          ticking = true;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      updatePageTurn();

      if (btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var targetY = track.offsetTop + (track.offsetHeight - window.innerHeight);
          window.scrollTo({
            top: targetY,
            behavior: 'smooth'
          });
        });
      }
    })();
  </script>
</body>
</html>

