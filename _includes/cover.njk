<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - Digital Book</title>
  <meta name="description" content="One homeless cat. One legendary castle. A shared destiny. Read the real-life adventures and story of Montsoriu.">

  {% include "partials/head-common.njk" %}
</head>
<body class="page-cover">
  <!-- Minimalist Overlay Header with Dark/Light Toggle -->
  <header class="site-header cover-header">
    <div class="header-inner">
      <a href="/" class="brand-link" aria-label="The Story of Montsoriu Home">
        <img src="/images/logo.png" alt="Montsoriu Logo" class="brand-logo" width="40" height="40">
        <div class="brand-text">
          <span class="brand-name">The Story of Montsoriu</span>
          <span class="brand-tagline">An Ongoing Digital Book</span>
        </div>
      </a>
      <div class="header-right-group">
        <!-- Top-Right Castle Shortcut Link (fades out when scrolling / navbar appears) -->
        <a href="https://www.montsoriu.cat" 
           target="_blank" 
           rel="noopener noreferrer" 
           class="castle-shortcut" 
           id="castle-shortcut" 
           title="Castell de Montsoriu (www.montsoriu.cat)" 
           aria-label="Looking for the castle? Cerques el castell? Visit Castell de Montsoriu official website">
          <div class="castle-shortcut-text">
            <span class="castle-line-en">Looking for the castle?</span>
            <span class="castle-line-ca">Cerques el castell?</span>
          </div>
          <div class="castle-shortcut-action">
            <svg class="castle-shortcut-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="4" y1="12" x2="19" y2="12"></line>
              <polyline points="13 6 19 12 13 18"></polyline>
            </svg>
            <div class="castle-shortcut-icon" aria-hidden="true">
              <svg class="castle-silhouette-svg" viewBox="0 0 32 32" fill="currentColor">
                <path d="M17 1v4.5h4.5L17 1z"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M4 8.5h2v2h2v-2h2v5.5h2V4.5h2v2h2v-2h2v2h2v-2h2v9.5h2v-5.5h2v2h2v-2h2v17.5H4V8.5z M6.2 14h1.6v4H6.2v-4z M24.2 14h1.6v4h-1.6v-4z M16 8.5h2v3.5h-2V8.5z M14.5 26v-5a2.5 2.5 0 0 1 5 0v5h-5z"/>
                <rect x="2" y="26" width="28" height="2" rx="1"/>
              </svg>
            </div>
          </div>
        </a>

        {% include "partials/header-actions.njk" %}
      </div>
    </div>
  </header>

  <main>
    <div class="book-experience" id="book-experience">
      <!-- Fixed Background Cover Image (Fades out as user scrolls) -->
      <div class="cover-bg-fixed" id="cover-bg" aria-hidden="true">
        <img src="/images/portada.jpg" 
             alt="Cover photograph of Montsoriu the cat standing gracefully in a sunlit tree" 
             class="hero-bg-img"
             fetchpriority="high"
             loading="eager"
             sizes="100vw"
             eleventy:widths="600,1000,1600,2200"
             eleventy:formats="avif,webp,jpeg">
      </div>

      <!-- Cover Hero Section (Takes initial full viewport) -->
      <section class="cover-hero-section" id="cover-hero" aria-label="Book Cover">
        <div class="cover-content-stack" id="cover-content">
          <div class="cover-logo-wrap">
            <img src="/images/logo.png" 
                 alt="Montsoriu cat silhouette in front of the rising sun" 
                 class="cover-hero-logo" 
                 width="88" 
                 height="85">
          </div>

          <h1 class="cover-hero-title is-over-image">{{ title }}</h1>
          
          <p class="cover-hero-tagline is-over-image">One homeless cat. One legendary castle. A shared destiny.</p>
        </div>

        <!-- Call to Action Button: Fades out quickly on initial scroll -->
        <div class="cover-hero-action" id="cover-action">
          <a href="#prologue" class="btn btn-journey" id="btn-begin-voyage" aria-label="Begin her voyage">
            <svg class="journey-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
            <span>Begin her voyage</span>
            <svg class="journey-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
        </div>
      </section>

      <!-- The Reading Page Canvas (Prologue text & Featured Chapter Card) -->
      <section class="book-page-canvas" id="prologue" aria-label="Prologue">
        <div class="book-page-inner" id="page-inner">
          <!-- Pure Prologue Text -->
          <div class="prose prologue-prose">
            {{ content | safe }}
          </div>

          <!-- Featured Chapter Callout with Translucid Glass & Cover Image -->
          {% set ch1 = collections.all | selectattr("url", "equalto", "/chapter-1-determined-to-live/") | first %}
          {% set ch1Cover = (ch1.data.cover if ch1 and ch1.data.cover else "/images/capitol01/castell-sense-torra.jpg") %}
          {% set ch1Title = (ch1.data.title if ch1 and ch1.data.title else "Determined to Live") %}
          {% set ch1Number = (ch1.data.number if ch1 and ch1.data.number else 1) %}
          <div class="chapter-cta-card">
            <!-- Background Image from Chapter Frontmatter -->
            <div class="chapter-cta-bg-wrap" aria-hidden="true">
              <img src="{{ ch1Cover }}" 
                   alt="" 
                   class="chapter-cta-bg-img" 
                   loading="lazy" 
                   sizes="(max-width: 768px) 100vw, 740px"
                   eleventy:widths="400,750,1100" 
                   eleventy:formats="avif,webp,jpeg">
            </div>

            <!-- Translucid Glass Overlay Layer -->
            <div class="chapter-cta-glass-overlay" aria-hidden="true"></div>

            <!-- Content Layer -->
            <div class="chapter-cta-content">
              {% if ch1Number %}
                <span class="chapter-cta-number">CHAPTER {{ ch1Number }}</span>
              {% endif %}
              <h3 class="chapter-cta-title">{{ ch1Title }}</h3>
              <p class="chapter-cta-desc">
                Weak, hurt, and lost in the dense woods under the shadow of the fortress, a hungry kitten hears strange footsteps echoing through the trees...
              </p>
            </div>

            <div class="chapter-cta-footer">
              <span class="chapter-cta-meta">Published • 10 min read</span>
              <a href="/chapter-1-determined-to-live/" class="btn btn-primary btn-sm">
                Start Chapter {{ ch1Number }} →
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <!-- Footer -->
  {% include "partials/footer.njk" %}

  <!-- Common Interactive Scripts (Theme & Navigation Dropdown) -->
  {% include "partials/scripts-common.njk" %}

  <!-- Cover-Specific Parallax, Faster Scroll-up & Fading on Scroll -->
  <script>
    (function() {
      var coverBg = document.getElementById('cover-bg');
      var coverContent = document.getElementById('cover-content');
      var coverAction = document.getElementById('cover-action');
      var castleShortcut = document.getElementById('castle-shortcut');
      var header = document.querySelector('.cover-header');
      var btn = document.getElementById('btn-begin-voyage');
      var menuBtn = document.getElementById('menu-toggle');
      var menuDropdown = document.getElementById('site-nav-menu');

      var ticking = false;

      function updateScrollEffects() {
        var scrolled = window.pageYOffset || document.documentElement.scrollTop || 0;
        var winH = window.innerHeight || 800;
        var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // A. Fixed Cover Background Image Fade-Out
        var bgFadeDist = winH * 0.9;
        var bgProgress = Math.min(Math.max(scrolled / bgFadeDist, 0), 1);
        var bgOpacity = Math.max(1 - bgProgress, 0);

        if (coverBg) {
          coverBg.style.opacity = bgOpacity;
          coverBg.style.visibility = bgOpacity <= 0 ? 'hidden' : 'visible';
        }

        // B. Logo / Title / Tagline: Scrolls up FASTER than text while fading out
        var contentFadeDist = winH * 0.85;
        var contentProgress = Math.min(Math.max(scrolled / contentFadeDist, 0), 1);
        var contentOpacity = Math.max(1 - contentProgress, 0);

        if (coverContent) {
          coverContent.style.opacity = contentOpacity;
          if (!prefersReduced) {
            coverContent.style.transform = 'translate3d(0, ' + (-scrolled * 0.6) + 'px, 0)';
          }
          coverContent.style.visibility = contentOpacity <= 0 ? 'hidden' : 'visible';
        }

        // C. Button ("Begin her voyage"): Fades out quickly on initial scroll
        var btnFadeDist = Math.min(winH * 0.2, 150);
        var btnProgress = Math.min(Math.max(scrolled / btnFadeDist, 0), 1);
        var btnOpacity = Math.max(1 - btnProgress, 0);

        if (coverAction) {
          coverAction.style.opacity = btnOpacity;
          coverAction.style.pointerEvents = btnOpacity < 0.05 ? 'none' : 'auto';
          if (!prefersReduced) {
            coverAction.style.transform = 'translate3d(0, ' + (scrolled * 0.2) + 'px, 0)';
          }
          coverAction.style.visibility = btnOpacity <= 0 ? 'hidden' : 'visible';
        }

        // D. Castle Shortcut: Fades out as user scrolls down and navbar appears
        var castleFadeDist = 60;
        var castleProgress = Math.min(Math.max(scrolled / castleFadeDist, 0), 1);
        var castleOpacity = Math.max(1 - castleProgress, 0);

        if (castleShortcut) {
          castleShortcut.style.opacity = castleOpacity;
          castleShortcut.style.pointerEvents = castleOpacity < 0.05 ? 'none' : 'auto';
          if (!prefersReduced) {
            castleShortcut.style.transform = 'translate3d(0, ' + (-scrolled * 0.2) + 'px, 0)';
          }
          castleShortcut.style.visibility = castleOpacity <= 0 ? 'hidden' : 'visible';
        }

        // E. Header frosted background
        if (header) {
          if (scrolled > 60) {
            header.classList.add('is-scrolled');
          } else {
            header.classList.remove('is-scrolled');
            if (menuDropdown && menuDropdown.classList.contains('is-open')) {
              menuDropdown.classList.remove('is-open');
              if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
            }
          }
        }

        ticking = false;
      }

      function onScroll() {
        if (!ticking) {
          requestAnimationFrame(updateScrollEffects);
          ticking = true;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      updateScrollEffects();

      // Smooth scroll button handler
      if (btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var target = document.getElementById('prologue');
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        });
      }
    })();
  </script>
</body>
</html>
