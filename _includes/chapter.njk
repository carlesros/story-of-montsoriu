<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if number %}Chapter {{ number }}: {% endif %}{{ title }} - The Story of Montsoriu</title>
  <meta name="description" content="{% if number %}Chapter {{ number }}: {% endif %}{{ title }} from The Story of Montsoriu digital book.">

  <!-- Theme Initializer (Defaults to system preference, prevents FOUC) -->
  <script>
    (function() {
      try {
        var savedTheme = localStorage.getItem('montsoriu-theme');
        if (savedTheme === 'dark' || savedTheme === 'light') {
          document.documentElement.setAttribute('data-theme', savedTheme);
        } else {
          var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', systemDark ? 'dark' : 'light');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="apple-touch-icon" href="/images/favicon.png">

  <!-- Google Fonts Preconnect & Stylesheets -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Great+Vibes&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Main Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="page-chapter">
  <!-- Minimalist Overlay Header with Back Link & Dark/Light Toggle (Always visible with backdrop) -->
  <header class="site-header cover-header chapter-cover-header">
    <div class="header-inner">
      <a href="/" class="brand-link" aria-label="Return to cover">
        <img src="/images/logo.png" alt="Montsoriu Logo" class="brand-logo" width="42" height="42">
        <div class="brand-text">
          <span class="brand-name">The Story of Montsoriu</span>
          <span class="brand-tagline">← Back to Cover</span>
        </div>
      </a>
      <div class="header-actions">
        <button type="button" class="theme-toggle-btn" id="theme-toggle" aria-label="Toggle dark and light theme" title="Toggle dark / light theme">
          <svg class="theme-icon sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="theme-icon moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main>
    <div class="book-experience" id="book-experience">
      <!-- Fixed Background Chapter Cover Image (Fades out as user scrolls, covers 3/4 viewport) -->
      {% set chapterCover = cover if cover else "/images/portada.jpg" %}
      <div class="cover-bg-fixed chapter-bg-fixed" id="cover-bg" aria-hidden="true">
        <img src="{{ chapterCover }}" 
             alt="{{ title }} cover photograph" 
             class="hero-bg-img"
             fetchpriority="high"
             loading="eager"
             sizes="100vw"
             eleventy:widths="600,1000,1600,2200"
             eleventy:formats="avif,webp,jpeg">
      </div>

      <!-- Chapter Hero Section (Occupies ~3/4 screen height, revealing text below) -->
      <section class="cover-hero-section chapter-hero-section" id="cover-hero" aria-label="{% if number %}Chapter {{ number }}: {% endif %}{{ title }} Cover">
        <div class="cover-content-stack chapter-content-stack" id="cover-content">
          {% if number %}
            <span class="chapter-hero-number is-over-image">CHAPTER {{ number }}</span>
          {% endif %}
          <h1 class="chapter-hero-title is-over-image">{{ title }}</h1>
        </div>
      </section>

      <!-- The Reading Page Canvas (Starts at 3/4 mark, visible from initial screen load) -->
      <section class="book-page-canvas chapter-page-canvas" id="chapter-content" aria-label="{{ title }}">
        <div class="book-page-inner chapter-page-inner" id="page-inner">
          <article class="chapter-container">
            <header class="chapter-header">
              {% if date and location %}
                <p class="chapter-meta-line"><em>{{ date | formatChapterDate }}. {{ location | trim | replace(r/\.$/, "") }}.</em></p>
              {% elif date %}
                <p class="chapter-meta-line"><em>{{ date | formatChapterDate }}.</em></p>
              {% elif location %}
                <p class="chapter-meta-line"><em>{{ location | trim | replace(r/\.$/, "") }}.</em></p>
              {% endif %}
              <div class="chapter-meta-divider" aria-hidden="true"></div>
            </header>

            <div class="chapter-prose prose">
              {{ content | safe }}
            </div>

            <nav class="chapter-nav" aria-label="Chapter Navigation">
              {% if prev %}
                <a href="{{ prev }}" class="btn btn-secondary">← Previous Chapter</a>
              {% else %}
                <a href="/" class="btn btn-secondary">← Cover / Prologue</a>
              {% endif %}

              {% if next %}
                <a href="{{ next }}" class="btn btn-primary">Next Chapter →</a>
              {% else %}
                <span class="btn btn-disabled" aria-disabled="true">To be continued…</span>
              {% endif %}
            </nav>
          </article>
        </div>
      </section>
    </div>
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-inner">
      <img src="/images/logo.png" alt="Montsoriu Logo" class="footer-logo" width="32" height="32">
      <p class="footer-text">
        <strong>The Story of Montsoriu</strong> — A digital book narrating the real-life adventures and journey of Montsoriu.
      </p>
      <p class="footer-copy">
        &copy; The Story of Montsoriu. All rights reserved.
      </p>
    </div>
  </footer>

  <!-- Scroll Parallax, Fade & Theme Script -->
  <script>
    (function() {
      // 1. Theme Toggle Logic
      var themeBtn = document.getElementById('theme-toggle');
      if (themeBtn) {
        themeBtn.addEventListener('click', function() {
          var currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
          var nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', nextTheme);
          try {
            localStorage.setItem('montsoriu-theme', nextTheme);
          } catch (e) {}
        });
      }

      // Listen for system theme changes if user hasn't explicitly set preference
      if (window.matchMedia) {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
          try {
            if (!localStorage.getItem('montsoriu-theme')) {
              document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
            }
          } catch (err) {}
        });
      }

      // 2. Parallax, Faster Scroll-up & Fading on Scroll
      var coverBg = document.getElementById('cover-bg');
      var coverContent = document.getElementById('cover-content');

      var ticking = false;

      function updateScrollEffects() {
        var scrolled = window.pageYOffset || document.documentElement.scrollTop || 0;
        var winH = window.innerHeight || 800;

        // Check for reduced motion preference
        var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // A. Fixed Cover Background Image Fade-Out (3/4 viewport scale)
        var bgFadeDist = winH * 0.65;
        var bgProgress = Math.min(Math.max(scrolled / bgFadeDist, 0), 1);
        var bgOpacity = Math.max(1 - bgProgress, 0);

        if (coverBg) {
          coverBg.style.opacity = bgOpacity;
          if (bgOpacity <= 0) {
            coverBg.style.visibility = 'hidden';
          } else {
            coverBg.style.visibility = 'visible';
          }
        }

        // B. Chapter Title: Scrolls up FASTER than text while fading out, sliding smoothly under top nav
        var contentFadeDist = winH * 0.65;
        var contentProgress = Math.min(Math.max(scrolled / contentFadeDist, 0), 1);
        var contentOpacity = Math.max(1 - contentProgress, 0);

        if (coverContent) {
          coverContent.style.opacity = contentOpacity;
          if (!prefersReduced) {
            var extraTranslateY = -scrolled * 0.6;
            coverContent.style.transform = 'translate3d(0, ' + extraTranslateY + 'px, 0)';
          }
          if (contentOpacity <= 0) {
            coverContent.style.visibility = 'hidden';
          } else {
            coverContent.style.visibility = 'visible';
          }
        }

        ticking = false;
      }

      function onScroll() {
        if (!ticking) {
          requestAnimationFrame(updateScrollEffects);
          ticking = true;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      updateScrollEffects();
    })();
  </script>
</body>
</html>
